# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# LLM enrichment — required at runtime for /api/ask and optional --enrich pass.
OPENROUTER_API_KEY=

# Neural web search — enables the --discover pass (Exa search API).
EXA_API_KEY=

# URL scraping to markdown — enables Firecrawl enrichment in --enrich-sources.
FIRECRAWL_API_KEY=

# Crunchbase org/deal lookup — enables Crunchbase enrichment in --enrich-sources.
CRUNCHBASE_API_KEY=

# Apollo org + key-contact lookup — enables Apollo enrichment in --enrich-sources.
APOLLO_API_KEY=

# LinkedIn data via Proxycurl — enables LinkedIn enrichment in --enrich-sources.
LINKEDIN_API_KEY=
